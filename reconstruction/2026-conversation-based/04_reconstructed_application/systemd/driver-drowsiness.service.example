# Copy and customize the Raspberry Pi username and absolute installation path.
# sudo cp ... /etc/systemd/system/driver-drowsiness.service
# sudo systemctl daemon-reload && sudo systemctl enable --now driver-drowsiness
# USB audio / camera user group access must be configured on the actual Pi.
[Unit]
Description=Driver Drowsiness Camera (reconstructed capstone)
After=multi-user.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/driver-drowsiness/04_reconstructed_application
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/driver-drowsiness/04_reconstructed_application/main.py --no-display
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
